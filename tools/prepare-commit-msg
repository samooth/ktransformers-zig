#!/usr/bin/env bash
# Two commit-time gates with DIFFERENT severities, because the two failures are
# not the same kind.
#
#   1. tools/check_commit_files.sh    — BLOCKING. Every staged file must be named
#      in the message. A staged file nobody named is unambiguously a mistake.
#   2. tools/check_staged_claims.sh   — ADVISORY. Another session's claim marker
#      in a staged file is often legitimate (their work may genuinely belong here),
#      so this appends a note and exits 0.
#
# The split is deliberate: the claim check was advisory and was ignored four times
# in ten minutes, which is worth exactly as much as not warning. The file check
# has no legitimate exception, so it refuses.
#
# Do not edit this file to change a severity. Put the policy in the two scripts,
# where it is versioned and testable.
msg_file="${1:-}"
src="${2:-}"
[ "$src" = "message" ] || exit 0

repo_root="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
[ -n "$repo_root" ] || exit 0
git diff --cached --quiet 2>/dev/null && exit 0

# 1. Advisory: annotate, never block.
warn="$("$repo_root/tools/check_staged_claims.sh" --message-file "$msg_file" --annotate 2>/dev/null)"
[ -n "$warn" ] && printf '\n%s\n' "$warn" >> "$msg_file"

# 2. Blocking: refuse the commit.
"$repo_root/tools/check_commit_files.sh" --message-file "$msg_file"
exit $?
