#!/usr/bin/env bash
# Advisory claim-sweep check. Appends a note to the message; NEVER blocks.
#
# ADVISORY ON PURPOSE. `.git/hooks/` is per-repository, not per-user, so every
# session on this clone shares this hook — which means a BLOCKING hook would break
# other sessions mid-flight rather than protect them. So this annotates and exits 0,
# and the note disappears as soon as the commit message declares the handle.
#
# Do not edit this file to make it stricter: put the policy in
# tools/check_staged_claims.sh instead, where it is versioned and testable.
msg_file="${1:-}"
src="${2:-}"
[ "$src" = "message" ] || exit 0
git diff --cached --quiet 2>/dev/null && exit 0
repo_root="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
[ -n "$repo_root" ] || exit 0
warn="$("$repo_root/tools/check_staged_claims.sh" --message-file "$msg_file" --annotate 2>/dev/null)"
[ -n "$warn" ] || exit 0
printf '\n%s\n' "$warn" >> "$msg_file"
exit 0
